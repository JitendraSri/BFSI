# Copy to .env and fill in. Never commit the real .env.

# --- Required ---
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/
DB_NAME=BFSI
SECRET_KEY=<long random string, e.g. python -c "import secrets; print(secrets.token_hex(32))">

# --- AI (needed for advisor chat, RAG answers, PDF/image import, AI fraud analysis) ---
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-lite-latest
# GEMINI_EMBED_MODEL=gemini-embedding-001   # dense retrieval (768-dim vectors)
# GEMINI_EMBED_INTERVAL=4                   # seconds between embedding batches (free-tier friendly)
# FINRAG_MAX_METADATA_CHUNKS=800            # cap on chunks per document sent for LLM metadata

# --- SEC EDGAR live ingestion (SEC requires a name and contact email in the User-Agent) ---
# SEC_USER_AGENT=FinRAG AI your-name you@example.com

# --- Email OTP via Brevo SMTP relay (needed for registration, password reset, KYC) ---
SMTP_SERVER=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_LOGIN=
SMTP_PASSWORD=
SENDER_EMAIL=

# --- Optional server settings ---
# HOST=127.0.0.1            # binding to anything else also turns the debugger off
# PORT=5000
# FLASK_DEBUG=1
# JWT_TTL_HOURS=24
# FRONTEND_ORIGIN=http://localhost:5000
# ENABLE_DIAGNOSTICS=0      # 1 exposes /test_db and /test-atlas
